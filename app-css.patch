+@import "tailwindcss";
+
+/* Hide Alpine.js elements before hydration */
+[x-cloak] {
+    display: none !important;
+}
+
+:root {
+    --boq-primary: #05645b;
+    --boq-accent: #d7df21;
+    --boq-sidebar: #0b1720;
+    --boq-sidebar-2: #101f2a;
+}
+
+body {
+    background: #f1f5f9;
+    color: #0f172a;
+}
+
+.boq-sidebar {
+    background:
