APP_NAME="BOQ System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://boq.kemmytech.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
# Fallback currency (ISO 4217) until one is chosen in Admin > Settings.
APP_DEFAULT_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kemmytech.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.kemmytech.com
MAIL_PORT=465
MAIL_USERNAME=YOUR_MAIL_USERNAME
MAIL_PASSWORD=YOUR_MAIL_PASSWORD
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=no-reply@kemmytech.com
MAIL_FROM_NAME="${APP_NAME}"

# Legacy environment-driven AI integration. Prefer the database AI Provider
# manager where that module is enabled. Do not commit real credentials.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_GROUNDING=true
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com


# Web Authn (passkeys). WEBAUTHN_ID defaults to the APP_URL host; set it only if the
# site is served from a different host name. WEBAUTHN_ORIGINS: comma-separated extra origins.
WEBAUTHN_NAME="${APP_NAME}"
WEBAUTHN_ID=
WEBAUTHN_ORIGINS=

# Payments. Gateways are normally managed in Admin > Payment Gateways; these are
# environment fallbacks. Never commit live keys.
PAYMENT_GATEWAY=stripe
STRIPE_MODE=live
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_URL=
MOBILE_MONEY_PROVIDER=
MOBILE_MONEY_MODE=live
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=
MOBILE_MONEY_MERCHANT_CODE=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_SWIFT_CODE=
BANK_TRANSFER_INSTRUCTIONS=

VITE_APP_NAME="${APP_NAME}"

# Optional one-time initial administrator seed. Remove values after seeding.
ADMIN_SEED_NAME="System Administrator"
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ORGANISATION="Default Organisation"
